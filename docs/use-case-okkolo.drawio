        <mxCell id="title" value="Диаграмма вариантов использования информационной системы «Окколо»" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="sys" value="Веб-сайт «Окколо»" style="swimlane;startSize=30;horizontal=0;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontSize=13;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="1280" height="980" as="geometry"/></mxCell><mxCell id="visitor" value="Посетитель" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="420" width="40" height="80" as="geometry"/></mxCell><mxCell id="admin" value="Администратор" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1420" y="420" width="40" height="80" as="geometry"/></mxCell><mxCell id="uc_info" value="Посмотреть информацию&amp;#xa;о проекте" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;fontSize=11;" vertex="1" parent="sys"><mxGeometry x="180" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc_about" value="Посмотреть раздел «О нас»" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;fontSize=11;" vertex="1" parent="sys"><mxGeometry x="420" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc_reports" value="Посмотреть отчёты" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;fontSize=11;" vertex="1" parent="sys"><mxGeometry x="660" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc_legal" value="Прочитать юридические&am